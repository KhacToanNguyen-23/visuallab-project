{
  "repository-harness": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/context.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/privacy_guard.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python hooks/tool_counter.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/quality_check.py",
            "timeout": 50
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/lifecycle_state.py",
        "timeout": 10
      }
    ]
  }
}
